# ======================================================
# CONFIGURACIÓN DEL SERVIDOR
# ======================================================
PORT=3000
NODE_ENV=development

# ======================================================
# BASE DE DATOS (PostgreSQL & Prisma)
# ======================================================
# Formato: postgresql://<USUARIO>:<PASSWORD>@<HOST>:<PUERTO>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventario?schema=public"

# ======================================================
# AUTENTICACIÓN JWT (jose)
# ======================================================
# Secreto seguro para firma de tokens (generar con 'openssl rand -base64 32')
JWT_SECRET="super-secret-jwt-key-change-in-production-at-least-32-chars-long"

# Emisor y Audiencia del token
JWT_ISS="inventario-api"
JWT_AUD="inventario-clients"

# Tiempo de expiración de Access Token (recomendado 15 minutos)
JWT_ACCESS_TTL="15m"

# Tiempo de expiración de Refresh Token (recomendado 7 días)
JWT_REFRESH_TTL="7d"

# ======================================================
# SERVICIOS EXTERNOS (Opcionales / Inactivos)
# ======================================================
EMAIL_LOGO_URL="https://pub-59913b0c53f044ad8a24e05f6a21ed2e.r2.dev/assets/logo-cad.png"
OTP_URL="http://localhost:8000/api/v1/"
OTP_PROVIDER=""
