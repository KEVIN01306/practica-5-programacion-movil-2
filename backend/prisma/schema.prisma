datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS
// ======================================================

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
}

enum FieldType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  DATE
  JSON
  URL
}

enum SubmissionStatus {
  PENDING
  PROCESSED
  SPAM
  FAILED
}

enum ContactStatus {
  LEAD
  ACTIVE
  UNSUBSCRIBED
  ARCHIVED
}

// ======================================================
// USER & AUTHENTICATION (RBAC)
// ======================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  isVerify     Boolean  @default(false) @map("is_verify")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userRoles UserRole[]
  session   UserSession?
  auditLogs AuditLog[]
  websites  Website[]    @relation("UserWebsites")

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Ej: "SUPER_ADMIN", "ADMIN", "USER"
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // Ej: "users:create", "websites:delete"
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ======================================================
// WEBSITES & MULTI-TENANCY
// ======================================================

model Website {
  id              String   @id @default(uuid())
  name            String
  domain          String   @unique
  apiKey          String   @unique @default(uuid()) @map("api_key")
  hostingProvider String?  @map("hosting_provider")
  hostingNotes    String?  @map("hosting_notes") @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  ownerId         String?  @map("owner_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner          User?           @relation("UserWebsites", fields: [ownerId], references: [id], onDelete: SetNull)
  contentTypes   ContentType[]
  forms          Form[]
  emailTemplates EmailTemplate[]
  contacts       Contact[]

  @@map("websites")
}

// ======================================================
// CONSUMABLES / CONTENT BUILDER (HEADLESS CMS)
// ======================================================

model ContentType {
  id          String   @id @default(uuid())
  websiteId   String   @map("website_id")
  name        String // Ej: "Productos", "Blog Posts"
  slug        String // Ej: "productos", "blog-posts"
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  website Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fields  ContentField[]
  items   ContentItem[]

  @@unique([websiteId, slug])
  @@map("content_types")
}

model ContentField {
  id            String    @id @default(uuid())
  contentTypeId String    @map("content_type_id")
  name          String // Ej: "Precio", "En Stock"
  key           String // Ej: "price", "in_stock"
  type          FieldType @default(STRING)
  isRequired    Boolean   @default(false) @map("is_required")
  createdAt     DateTime  @default(now()) @map("created_at")

  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, key])
  @@map("content_fields")
}

model ContentItem {
  id            String   @id @default(uuid())
  contentTypeId String   @map("content_type_id")
  data          Json // Payload flexible: { "price": 99.99, "in_stock": true }
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@map("content_items")
}

// ======================================================
// EMAIL TEMPLATES
// ======================================================

model EmailTemplate {
  id          String   @id @default(uuid())
  websiteId   String   @map("website_id")
  name        String // Ej: "Notificación de Contacto"
  subject     String // Ej: "Nuevo mensaje de {{name}}"
  htmlContent String   @map("html_content") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  forms   Form[]

  @@map("email_templates")
}

// ======================================================
// FORM BUILDER & SUBMISSIONS
// ======================================================

model Form {
  id              String   @id @default(uuid())
  websiteId       String   @map("website_id")
  name            String // Ej: "Formulario de Contacto Principal"
  slug            String // Identificador de endpoint: /api/v1/forms/:slug/submit
  sendEmail       Boolean  @default(false) @map("send_email")
  emailFrom       String?  @map("email_from")
  recipientEmails Json?    @map("recipient_emails")
  emailTemplateId String?  @map("email_template_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  website       Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  emailTemplate EmailTemplate?   @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  fields        FormField[]
  submissions   FormSubmission[]

  @@unique([websiteId, slug])
  @@map("forms")
}

model FormField {
  id         String    @id @default(uuid())
  formId     String    @map("form_id")
  label      String // Ej: "Correo Electrónico"
  key        String // Ej: "email"
  type       FieldType @default(STRING)
  isRequired Boolean   @default(false) @map("is_required")
  createdAt  DateTime  @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@map("form_fields")
}

model FormSubmission {
  id        String           @id @default(uuid())
  formId    String           @map("form_id")
  contactId String?          @map("contact_id")
  data      Json // Raw data: { "name": "Juan", "email": "juan@example.com", "message": "Hola" }
  status    SubmissionStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")

  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("form_submissions")
}

// ======================================================
// CONTACTS & CRM CORE
// ======================================================

model Contact {
  id         String        @id @default(uuid())
  websiteId  String        @map("website_id")
  email      String
  firstName  String?       @map("first_name")
  lastName   String?       @map("last_name")
  phone      String?
  company    String?
  status     ContactStatus @default(LEAD)
  customData Json?         @map("custom_data") // Datos extra recolectados
  tags       Json? // Ej: ["landing-astro", "boletin"]
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  website     Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@unique([websiteId, email])
  @@index([email])
  @@map("contacts")
}

// ======================================================
// AUDIT SYSTEM
// ======================================================

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  resource   String // Ej: "websites", "users", "forms"
  resourceId String?     @map("resource_id")
  details    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
